<!DOCTYPE html>
@using MeuPortfolio.Services
@inject IPortfolioService Portfolio
@{
    var perfil = await Portfolio.ObterPerfilAsync();
}
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO / compartilhamento -->
    <meta name="description" content="Portfólio de [Seu Nome] – Desenvolvedor .NET" />
    <meta property="og:title" content="[Seu Nome] | Portfólio" />
    <meta property="og:description" content="Projetos, habilidades e contato de [Seu Nome], desenvolvedor ASP.NET Core." />
    <meta property="og:image" content="https://SEUSITE.com/img/perfil.jpg" />
    <meta property="og:type" content="website" />

    <title>@ViewData["Title"] - @perfil.Nome</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top bg-body-tertiary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">&lt;@perfil.Nome /&gt;</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/#sobre">Sobre</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#habilidades">Habilidades</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#projetos">Projetos</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#contato">Contato</a></li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">Painel</a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">Sair</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Login">Entrar</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer id="contato" class="py-5 bg-body-tertiary mt-5">
        <div class="container text-center">
            <h4 class="mb-3">Vamos conversar?</h4>
            <p class="text-secondary">@perfil.Email · @perfil.Telefone · @perfil.Localizacao</p>
            <div class="d-flex justify-content-center gap-3 fs-3">
                @foreach (var rede in perfil.RedesSociais)
                {
                    <a href="@rede.Url" target="_blank" rel="noopener" class="social-link" title="@rede.Nome">
                        <i class="@rede.Icone"></i>
                    </a>
                }
            </div>
            <p class="mt-4 small text-secondary">© @DateTime.Now.Year @perfil.Nome. Feito com ASP.NET Core.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

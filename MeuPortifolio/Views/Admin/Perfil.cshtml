@model MeuPortfolio.Models.Perfil

@{ ViewData["Title"] = "Perfil"; }

<section class="py-5 mt-5">
    <div class="container">
        <a asp-action="Index" class="d-inline-block mb-3"><i class="bi bi-arrow-left"></i> Voltar</a>
        <h2 class="mb-4">Meu perfil</h2>

        <div class="row g-5">
            <div class="col-lg-6">
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3"><label class="form-label">Nome</label><input asp-for="Nome" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Cargo</label><input asp-for="Cargo" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Resumo</label><textarea asp-for="Resumo" class="form-control" rows="4"></textarea></div>
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="form-label">E-mail</label><input asp-for="Email" class="form-control" /></div>
                        <div class="col-md-6 mb-3"><label class="form-label">Telefone</label><input asp-for="Telefone" class="form-control" /></div>
                    </div>
                    <div class="mb-3"><label class="form-label">Localização</label><input asp-for="Localizacao" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Link do currículo (PDF)</label><input asp-for="CurriculoUrl" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Foto</label>
                        <input name="foto" type="file" accept="image/*" class="form-control" />
                        <img src="@Model.FotoUrl" class="mt-2 rounded-circle" style="width:100px;height:100px;object-fit:cover" /></div>
                    <button class="btn btn-primary"><i class="bi bi-save me-1"></i> Salvar</button>
                </form>
            </div>

            <div class="col-lg-6">
                <h4>Habilidades</h4>
                <form asp-action="AdicionarHabilidade" method="post" class="row g-2 mb-3">
                    <div class="col-4"><input name="nome" class="form-control" placeholder="Nome" required /></div>
                    <div class="col-2"><input name="nivel" type="number" min="0" max="100" class="form-control" placeholder="%" required /></div>
                    <div class="col-4"><input name="icone" class="form-control" placeholder="devicon-csharp-plain" /></div>
                    <div class="col-2"><button class="btn btn-outline-light w-100">+</button></div>
                </form>
                <ul class="list-group mb-5">
              @foreach (var h in Model.Habilidades)
                {
                    <li class="list-group-item d-flex align-items-center gap-2">
                        <span class="flex-grow-1"><i class="@h.Icone"></i> @h.Nome — @h.Nivel%</span>

                        <form asp-action="AtualizarIconeHabilidade" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@h.Id" />
                            <input name="icone" value="@h.Icone" class="form-control form-control-sm"
                                   placeholder="devicon-..." style="width:200px" />
                            <button class="btn btn-sm btn-outline-success">✓</button>
                        </form>

                        <form asp-action="RemoverHabilidade" method="post">
                            <input type="hidden" name="id" value="@h.Id" />
                            <button class="btn btn-sm btn-outline-danger">×</button>
                        </form>
                    </li>
                }

                </ul>

                <h4>Redes sociais</h4>
                <form asp-action="AdicionarRede" method="post" class="row g-2 mb-3">
                    <div class="col-3"><input name="nome" class="form-control" placeholder="GitHub" required /></div>
                    <div class="col-4"><input name="url" class="form-control" placeholder="https://..." required /></div>
                    <div class="col-3"><input name="icone" class="form-control" placeholder="bi bi-github" /></div>
                    <div class="col-2"><button class="btn btn-outline-light w-100">+</button></div>
                </form>
                <ul class="list-group">
                @foreach (var r in Model.RedesSociais)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="@r.Icone me-2"></i>@r.Nome</span>
                        <form asp-action="ExcluirRede" asp-route-id="@r.Id" method="post">
                            <button class="btn btn-sm btn-outline-danger">×</button></form>
                    </li>
                }
                </ul>
            </div>
        </div>
    </div>
</section>

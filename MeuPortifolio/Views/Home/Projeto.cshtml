@model MeuPortfolio.Models.Projeto
@{
    ViewData["Title"] = Model.Titulo;
}

<section class="py-5 mt-5">
    <div class="container">
        <a asp-action="Index" asp-fragment="projetos" class="text-decoration-none mb-3 d-inline-block">
            <i class="bi bi-arrow-left"></i> Voltar aos projetos
        </a>

        <h1 class="fw-bold">@Model.Titulo</h1>
        <div class="mb-3">
            @foreach (var t in Model.Tecnologias)
            {
                <span class="badge text-bg-dark border me-1">@t</span>
            }
        </div>

        <div class="d-flex gap-2 mb-4">
            @if (Model.RepositorioUrl is not null)
            {
                <a href="@Model.RepositorioUrl" target="_blank" class="btn btn-outline-light"><i class="bi bi-github me-1"></i> Código no GitHub</a>
            }
            @if (Model.DemoUrl is not null)
            {
                <a href="@Model.DemoUrl" target="_blank" class="btn btn-primary"><i class="bi bi-box-arrow-up-right me-1"></i> Ver online</a>
            }
        </div>

        <div class="row g-5">
            <div class="col-lg-5">
                <h4>Sobre o projeto</h4>
                <p class="text-secondary" style="white-space: pre-line">@Model.DescricaoCompleta</p>
            </div>

            <div class="col-lg-7">
                <h4>Galeria</h4>
                <div class="row g-3">
                    @foreach (var m in Model.Midias)
                    {
                        <div class="col-12">
                            <figure class="media-figure">
                                @switch (m.Tipo)
                                {
                                    case MeuPortfolio.Models.TipoMidia.Imagem:
                                        <img src="@m.Url" alt="@m.Legenda" class="img-fluid rounded shadow" loading="lazy" />
                                        break;
                                    case MeuPortfolio.Models.TipoMidia.Video:
                                        <video controls class="w-100 rounded shadow" preload="metadata">
                                            <source src="@m.Url" type="video/mp4" />
                                            Seu navegador não suporta vídeo.
                                        </video>
                                        break;
                                    case MeuPortfolio.Models.TipoMidia.YouTube:
                                        <div class="ratio ratio-16x9 rounded shadow overflow-hidden">
                                            <iframe src="@m.Url" title="@m.Legenda" allowfullscreen loading="lazy"></iframe>
                                        </div>
                                        break;
                                }
                                @if (!string.IsNullOrWhiteSpace(m.Legenda))
                                {
                                    <figcaption class="text-secondary small mt-2">@m.Legenda</figcaption>
                                }
                            </figure>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

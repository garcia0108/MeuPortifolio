@model List<MeuPortfolio.Models.Projeto>

@{ ViewData["Title"] = "Projetos"; }

<section class="py-5 mt-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Projetos</h2>
            <div class="d-flex gap-2">
                <a asp-action="Perfil" class="btn btn-outline-light"><i class="bi bi-person me-1"></i> Perfil</a>
                <a asp-action="Editar" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Novo projeto</a>
                <form asp-action="Logout" method="post"><button class="btn btn-outline-danger">Sair</button></form>
            </div>
        </div>

        <table class="table table-dark table-hover align-middle">
            <thead><tr><th>Ordem</th><th>Capa</th><th>Título</th><th>Slug</th><th>Mídias</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Ordem</td>
                    <td><img src="@p.CapaUrl" style="width:80px;height:50px;object-fit:cover" class="rounded" /></td>
                    <td>@p.Titulo</td>
                    <td><a href="/projetos/@p.Slug" target="_blank">/projetos/@p.Slug</a></td>
                    <td>@p.Midias.Count</td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-light">Editar</a>
                        <form asp-action="Excluir" asp-route-id="@p.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Excluir este projeto?')">
                            <button class="btn btn-sm btn-outline-danger">Excluir</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
